# Dedicated limited key. Never commit a real key. Recommended key limit: $25.
OPENROUTER_API_KEY=
BLAST_WEEKLY_BUDGET_USD=5
BLAST_REFERER=https://localhost/blast-radius
# Optional exact model IDs; all must exist in the current models catalog.
BLAST_CLASSIFY_MODEL=
BLAST_RESEARCH_MODEL=
BLAST_WRITE_MODEL=
# Legacy web plugin remains configurable while OpenRouter migrates to server tools.
BLAST_WEB_PLUGIN=1
