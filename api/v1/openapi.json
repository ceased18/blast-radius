    "/api/status": {
      "get": {
        "operationId": "pgServiceStatus",
        "servers": [
          {
            "url": "https://blast-radius-plans.alluringdoor.chatgpt.site"
          }
        ],
        "summary": "Read service readiness and shared budget without a model call",
        "security": [],
        "responses": {
          "200": {
            "description": "Service readiness, can_generate and current budget.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "503": {
            "description": "Budget database or service state unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/pg-plan/{cache_key}": {
      "get": {
        "operationId": "readPgPlanJob",
        "servers": [
          {
            "url": "https://blast-radius-plans.alluringdoor.chatgpt.site"
          }
        ],
        "summary": "Poll a known request key without creating another paid request",
        "security": [],
        "parameters": [
          {
            "name": "cache_key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cached completed/failed request envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
