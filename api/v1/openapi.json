{
  "openapi": "3.1.0",
  "info": {
    "title": "Blast Radius PG planning and public evidence",
    "version": "1.1.0",
    "description": "Read-only static JSON for six deliberately selected companies. Not live monitoring, enrichment, a complete outage history, or qualified pipeline. No API key required. Local CLI/MCP return structured not_covered for unknown domains; a static URL outside the published index returns the host's ordinary HTTP404, not a health verdict. A separate public PG service performs explicit one-account research requests using its own capped OpenRouter budget. Operation-level servers point those requests to the PG runtime, not GitHub Pages. Availability is established by actual service responses."
  },
  "servers": [
    {
      "url": "https://ceased18.github.io/blast-radius"
    }
  ],
  "security": [],
  "paths": {
    "/api/v1/manifest.json": {
      "get": {
        "operationId": "snapshotManifest",
        "summary": "Read scope, freshness and discovery paths",
        "responses": {
          "200": {
            "description": "Frozen public snapshot manifest",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/accounts/index.json": {
      "get": {
        "operationId": "accountIndex",
        "summary": "Enumerate all six covered domains before lookup",
        "responses": {
          "200": {
            "description": "Complete index of this selected pack, not a market universe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/index.schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/accounts/{domain}.json": {
      "get": {
        "operationId": "companyEvidence",
        "summary": "Read the published evidence and counterevidence for one known domain",
        "parameters": [
          {
            "name": "domain",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "cartesia.ai",
                "github.com",
                "glean.com",
                "gorgias.com",
                "hubspot.com",
                "omni.co"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bounded account evidence, current-documentation counterevidence, open questions and source timestamps",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/account.schema.json"
                }
              }
            }
          },
          "404": {
            "description": "Domain is not a published static record, or the requested artifact is unavailable. This is not evidence of no incidents, no pain, or no opportunity. Consult the index.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/pg-plan": {
      "post": {
        "operationId": "generatePgPlan",
        "servers": [
          {
            "url": "https://blast-radius-plans.alluringdoor.chatgpt.site"
          }
        ],
        "summary": "Explicit one-account PG research through the capped public OpenRouter service",
        "description": "No visitor key. Shared $0.25 total demo cap, not a per-caller allowance. Caller supplies seller/account; the service does not select or rank accounts or write outreach. Output fixes 3 pains, 3 personas, verified tools or None found, 1 hypothesis and an empty weekly goal. Inspect actual status, provenance, usage and budget; do not automatically retry uncertain sent requests.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./schemas/pg-plan-request.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Completed/cached plan, or an honest research/plan-unavailable envelope after an attempt.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "schema_version": {
                      "const": "1.0"
                    },
                    "status": {
                      "type": "string",
                      "description": "complete/cached can include a plan; research_unavailable, budget_exhausted, in_progress and plan_unavailable are not successful research."
                    },
                    "plan": {
                      "oneOf": [
                        {
                          "$ref": "./schemas/pg-plan.schema.json"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "request_id": {
                      "type": "string"
                    },
                    "cache_key": {
                      "type": "string"
                    },
                    "cached_at": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "research": {
                      "type": "object",
                      "description": "Sanitized retrieved-source provenance, check date, coverage gaps and web-search count. Raw source bodies are not public."
                    },
                    "usage": {
                      "type": "object",
                      "description": "Actual reported cost and request metadata, including served model, requested fallback models and generation IDs. Reservations are not actual spend."
                    },
                    "budget": {
                      "type": "object",
                      "description": "Shared lifetime demo budget: cap_microusd=250000, committed/remaining amounts and unresolved accounting state."
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          },
          "202": {
            "description": "Same request is in progress; use the returned cache key with the safe GET poll route.",
